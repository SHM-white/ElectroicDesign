{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ED immutable YOLO dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source", "class_map", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "class_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/class"}},
    "samples": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/sample"}}
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false, "required": ["url", "revision", "license"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "license": {"type": "string", "minLength": 1}}},
    "class": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string", "minLength": 1}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["id", "split", "sha256", "source_url", "license", "class_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "split": {"enum": ["train", "val", "test"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_url": {"type": "string", "pattern": "^https://"}, "license": {"type": "string", "minLength": 1}, "class_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}}
  }
}
