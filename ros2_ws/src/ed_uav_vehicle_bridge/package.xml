<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ed_uav_vehicle_bridge</name>
  <version>0.1.0</version>
  <description>Authenticated UDP bridge for D-task vehicle telemetry and HMI selection.</description>
  <maintainer email="maintainers@example.invalid">ED UAV maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>ed_uav_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-typing-extensions</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
