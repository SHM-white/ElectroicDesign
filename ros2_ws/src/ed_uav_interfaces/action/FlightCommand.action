# Goal. Geometry is SI/ENU in target_pose.header.frame_id; unused fields are zero.
uint8 COMMAND_ARM=1
uint8 COMMAND_DISARM=2
uint8 COMMAND_SET_MODE=3
uint8 COMMAND_TAKEOFF=4
uint8 COMMAND_MOVE=5
uint8 COMMAND_HOVER=6
uint8 COMMAND_LAND=7
uint8 command
uint8 requested_mode
geometry_msgs/PoseStamped target_pose
geometry_msgs/Twist target_velocity
float32 timeout_sec
string<=64 correlation_id
---
# Result.
uint8 RESULT_SUCCEEDED=0
uint8 RESULT_REJECTED=1
uint8 RESULT_TIMEOUT=2
uint8 RESULT_FCU_ERROR=3
uint8 result_code
builtin_interfaces/Time completed_stamp
string<=96 reason
---
# Feedback.
uint8 STATE_QUEUED=0
uint8 STATE_SENT=1
uint8 STATE_ACKNOWLEDGED=2
uint8 STATE_EXECUTING=3
uint8 STATE_TERMINAL=4
uint8 execution_state
float32 progress
string<=64 correlation_id
