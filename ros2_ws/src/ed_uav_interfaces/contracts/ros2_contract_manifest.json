{
  "schema_version": 1,
  "interfaces": [
    {"path": "msg/FcuState.msg", "definition": "builtin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nstring<=64 frame_id"},
    {"path": "msg/LocalizationStatus.msg", "definition": "builtin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nstring<=96 reason"},
    {"path": "msg/BoundaryObservation.msg", "definition": "std_msgs/Header header\nuint32 source_sequence\nuint8 observable_dof_mask\ngeometry_msgs/PoseWithCovariance pose\nstring<=64 association_id"},
    {"path": "msg/VehicleTelemetry.msg", "definition": "uint16 contract_version\nbuiltin_interfaces/Time start_stamp\nbuiltin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nuint16 checksum_crc16\nstring<=32 vehicle_id\nbool start_event\nbool heartbeat_alive\nuint8 motion_kind\nfloat32 displacement_m\nfloat32 wheel_speed_m_s\nuint8 turn_class\nuint8 route_stage\nbool lap_complete\nstring<=32 frame_id"},
    {"path": "msg/TargetObservation.msg", "definition": "uint16 contract_version\nbuiltin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nstring<=32 observation_id\nstring<=32 target_revision\nstring<=64 frame_id\ngeometry_msgs/PoseWithCovariance pose\nfloat32 confidence\nfloat32 outer_diameter_m\nfloat32 inner_diameter_m\nfloat32 line_width_m"},
    {"path": "msg/MissionStatus.msg", "definition": "uint16 contract_version\nbuiltin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nstring<=64 mission_id\nuint8 state\nuint8 route_stage\nbool complete\nstring<=96 reason"},
    {"path": "msg/PayloadContactState.msg", "definition": "uint16 contract_version\nbuiltin_interfaces/Time acquisition_stamp\nuint32 source_sequence\nuint8 payload_state\nuint8 contact_state\nbool contact_stable\nfloat32 contact_duration_s\nstring<=64 owner\nstring<=64 frame_id"},
    {"path": "action/FlightCommand.action", "definition": "uint8 command\ngeometry_msgs/PoseStamped target_pose\ngeometry_msgs/Twist target_velocity\nstring<=64 correlation_id\n---\nuint8 result_code\nstring<=96 reason\n---\nuint8 execution_state"},
    {"path": "action/ExecuteMission.action", "definition": "string<=64 mission_id\nstring<=96 field_profile_id\n---\nuint8 result_code\nstring<=96 reason\n---\nstring<=64 state_id"},
    {"path": "srv/StartMapSession.srv", "definition": "string<=64 session_id\nstring<=128 archive_root\n---\nbool accepted\nstring<=96 reason\nstring<=128 staging_uri"},
    {"path": "srv/SelectDTaskMission.srv", "definition": "uint16 contract_version\nstring<=64 mission_id\nstring<=64 mission_profile_id\nstring<=64 deployment_preset_id\nstring<=32 target_revision\nuint8 task\n---\nbool accepted\nuint16 contract_version\nstring<=96 reason"}
  ],
  "topics": [
