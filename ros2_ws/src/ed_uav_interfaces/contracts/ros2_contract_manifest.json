    {"name": "/fast_lio/tf", "type": "tf2_msgs/msg/TFMessage", "owner": "fast_lio.fastlio_mapping", "qos": "state_reliable", "units": "private transform graph", "frame": "camera_init", "clock": "source_acquisition_ros_time", "freshness": "0.15 s"},
