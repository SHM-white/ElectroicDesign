    {"name": "/camera/wide/image_raw", "type": "sensor_msgs/msg/Image", "owner": "ed_uav_camera.wide", "qos": "sensor_data_best_effort", "units": "pixel intensity", "frame": "camera_wide_optical_frame", "clock": "camera_acquisition_ros_time", "freshness": "0.20 s"},
