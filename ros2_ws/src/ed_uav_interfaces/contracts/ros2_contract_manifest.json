    {"name": "/localization/lio/path", "type": "nav_msgs/msg/Path", "owner": "ed_uav_localization.lio_adapter", "qos": "state_reliable", "units": "SI: m, rad", "frame": "odom", "clock": "source_acquisition_ros_time", "freshness": "0.15 s"},
    {"name": "/localization/boundary_observation", "type": "ed_uav_interfaces/msg/BoundaryObservation", "owner": "ed_uav_perception.boundary", "qos": "state_reliable", "units": "SI: m, rad", "frame": "camera_wide_optical_frame", "clock": "camera_acquisition_ros_time", "freshness": "0.20 s"},
    {"name": "/localization/status", "type": "ed_uav_interfaces/msg/LocalizationStatus", "owner": "ed_uav_localization.supervisor", "qos": "state_reliable", "units": "SI: s", "frame": "map", "clock": "steady_clock_age", "freshness": "0.20 s"},
