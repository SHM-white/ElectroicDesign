{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed-uav.invalid/schemas/d-task/mission-profile-v1.json",
  "title": "D-task mission profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mission_profile_id", "task", "owner", "units", "frame", "freshness", "target_revision", "route_order", "cruise_altitude_m", "timing"],
  "properties": {
    "version": {"const": 1},
    "mission_profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "task": {"enum": ["payload_drop", "dynamic_landing"]},
    "owner": {"const": "ed_uav_mission"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "speed", "time"],
      "properties": {"length": {"const": "m"}, "speed": {"const": "m/s"}, "time": {"const": "s"}}
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "convention"],
      "properties": {"id": {"const": "map"}, "convention": {"const": "ENU"}}
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicle_telemetry_ms", "target_observation_ms", "mission_status_ms"],
      "properties": {
        "vehicle_telemetry_ms": {"type": "integer", "minimum": 1, "maximum": 2000},
        "target_observation_ms": {"type": "integer", "minimum": 1, "maximum": 2000},
        "mission_status_ms": {"type": "integer", "minimum": 1, "maximum": 5000}
      }
    },
    "target_revision": {"const": "d2026-circle-cross-v1"},
    "route_order": {
      "type": "array",
      "prefixItems": [{"const": "B"}, {"const": "D"}, {"const": "A"}],
      "minItems": 3,
      "maxItems": 3
    },
    "cruise_altitude_m": {"type": "number", "minimum": 1.4, "maximum": 1.6},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["takeoff_deadline_s", "mission_deadline_s", "vehicle_dwell_s"],
      "properties": {
        "takeoff_deadline_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 15},
        "mission_deadline_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
        "vehicle_dwell_s": {"type": "number", "minimum": 5, "maximum": 15}
      }
    }
  }
}
