<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ed_uav_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress simulator arena, vehicle adapters, and RViz configuration for ED UAV.</description>
  <maintainer email="maintainers@example.com">ED UAV maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>ed_uav_bringup</depend>
  <depend>ed_uav_description</depend>
  <depend>ed_uav_interfaces</depend>
  <depend>ed_uav_localization</depend>
  <depend>ed_uav_mission</depend>
  <depend>ed_uav_navigation</depend>
  <depend>ed_uav_perception</depend>
  <depend>fast_lio</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_sim</depend>
  <depend>rosgraph_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-typing-extensions</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
