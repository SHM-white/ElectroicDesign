      <visual name="right_straight"><pose>3.0 2.75 0.006 0 0 0</pose><geometry><box><size>0.03 1.50 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      <visual name="top_0"><pose>1.5144 3.6463 0.006 0 0 1.3744</pose><geometry><box><size>0.293 0.03 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
