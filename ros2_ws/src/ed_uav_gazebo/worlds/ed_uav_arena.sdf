      <visual name="top_2"><pose>1.8333 4.1236 0.006 0 0 0.5890</pose><geometry><box><size>0.293 0.03 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
