      <visual name="top_6"><pose>2.8736 3.9167 0.006 0 0 -0.9817</pose><geometry><box><size>0.293 0.03 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
