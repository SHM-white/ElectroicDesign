<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ed_uav_arena">
    <gravity>0 0 -9.81</gravity>
    <physics name="fortress_physics" type="ode">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor><real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene><ambient>0.38 0.42 0.48 1</ambient><background>0.08 0.10 0.14 1</background><shadows>true</shadows></scene>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light name="sun" type="directional"><pose>0 0 12 0.4 -0.5 0</pose><cast_shadows>true</cast_shadows><direction>-0.3 0.2 -1</direction><diffuse>0.9 0.9 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.12 0.15 0.18 1</ambient><diffuse>0.18 0.22 0.26 1</diffuse></material></visual></link></model>

    <model name="arena_north_wall"><static>true</static><pose>0 8 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>16 0.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>16 0.2 2</size></box></geometry><material><diffuse>0.32 0.36 0.42 1</diffuse></material></visual></link></model>
    <model name="arena_south_wall"><static>true</static><pose>0 -8 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>16 0.2 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>16 0.2 2</size></box></geometry><material><diffuse>0.32 0.36 0.42 1</diffuse></material></visual></link></model>
    <model name="arena_east_wall"><static>true</static><pose>8 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 16 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 16 2</size></box></geometry><material><diffuse>0.32 0.36 0.42 1</diffuse></material></visual></link></model>
    <model name="arena_west_wall"><static>true</static><pose>-8 0 1 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 16 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 16 2</size></box></geometry><material><diffuse>0.32 0.36 0.42 1</diffuse></material></visual></link></model>

    <model name="obstacle_block"><static>true</static><pose>2.5 1.5 0.75 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>1.5 1.5 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 1.5 1.5</size></box></geometry><material><diffuse>0.8 0.25 0.16 1</diffuse></material></visual></link></model>
    <model name="obstacle_cylinder"><static>true</static><pose>-2.2 -1.8 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.75</radius><length>1.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.75</radius><length>1.6</length></cylinder></geometry><material><diffuse>0.18 0.65 0.34 1</diffuse></material></visual></link></model>
    <model name="marker_gate"><static>true</static><pose>-3.5 3.0 1.0 0 0 0</pose><link name="left"><visual name="visual"><geometry><cylinder><radius>0.08</radius><length>2</length></cylinder></geometry><material><diffuse>0.95 0.8 0.08 1</diffuse></material></visual></link><link name="right"><pose>2 0 0 0 0 0</pose><visual name="visual"><geometry><cylinder><radius>0.08</radius><length>2</length></cylinder></geometry><material><diffuse>0.95 0.8 0.08 1</diffuse></material></visual></link><link name="top"><pose>1 0 1 0 0 0</pose><visual name="visual"><geometry><box><size>2.1 0.12 0.12</size></box></geometry><material><diffuse>0.95 0.8 0.08 1</diffuse></material></visual></link></model>

    <include><uri>model://ed_quadrotor</uri><name>ed_quadrotor</name><pose>0 0 0.45 0 0 0</pose></include>
  </world>
</sdf>
