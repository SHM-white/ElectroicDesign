      <visual name="bottom_0"><pose>2.9856 1.8537 0.006 0 0 -1.7671</pose><geometry><box><size>0.293 0.03 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
      <visual name="bottom_1"><pose>2.8736 1.5833 0.006 0 0 -2.1598</pose><geometry><box><size>0.293 0.03 0.006</size></box></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
