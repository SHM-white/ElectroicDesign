# ED UAV 热点配置示例
# 复制为 hotspot.local.env 并填入真实值
# 使用：source tools/hotspot/hotspot.local.env && sudo -E ./tools/hotspot/setup_hotspot.sh create

# 无线接口（留空自动检测）
export ED_HOTSPOT_IFACE=""

# 热点名称（两个 ESP32 的 config_local.h 中 WIFI_SSID 必须与此一致）
export ED_HOTSPOT_SSID="ED-UAV"

# WPA2 密码（留空则开放网络；正式比赛必须设密码）
export ED_HOTSPOT_PASSWORD=""

# 信道（1, 6, 11 最稳定；比赛场地应提前扫描选择最少干扰的信道）
export ED_HOTSPOT_CHANNEL="6"

# 频段：bg = 2.4GHz（ESP32 只支持 2.4G），a = 5GHz
export ED_HOTSPOT_BAND="bg"

# ESP32 MAC 地址（从设备背面或串口启动日志读取）
# 格式：AA:BB:CC:DD:EE:FF
# 设置后 DHCP 会为设备分配固定 IP
export ED_CAR_MAC=""
export ED_HMI_MAC=""
