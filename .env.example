# OpenCode 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 小米 API 配置
XIAOMI_API_KEY=your_xiaomi_api_key_here
# XIAOMI_BASE_URL=https://api.xiaomi.com/v1  # 可选，默认值

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # 可选，默认值

# OpenCode 配置
# OPENCODE_LOG_LEVEL=DEBUG  # 可选：DEBUG, INFO, WARN, ERROR
# OPENCODE_DISABLE_PROJECT_CONFIG=0  # 可选：设置为1禁用项目配置
# OPENCODE_CONFIG=/path/to/config.json  # 可选：指定额外配置文件

# 代理配置
# HTTP_PROXY=http://proxy.example.com:8080  # 可选：HTTP代理
# HTTPS_PROXY=http://proxy.example.com:8080  # 可选：HTTPS代理
# NO_PROXY=localhost,127.0.0.1  # 可选：不使用代理的地址

# 超时配置（毫秒）
# OPENCODE_TIMEOUT=30000  # 可选：请求超时时间
# OPENCODE_MCP_TIMEOUT=5000  # 可选：MCP服务器超时时间

# 其他配置
# OPENCODE_SHARE=manual  # 可选：manual, auto, disabled
# OPENCODE_AUTOUPDATE=true  # 可选：true, false, notify
# OPENCODE_SNAPSHOT=true  # 可选：true, false